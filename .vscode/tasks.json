{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "host: build",
      "type": "process",
      "command": "wsl",
      "args": ["--cd", "${workspaceFolder}", "-e", "bash", "-l", "tools/scripts/build_host.sh"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "host: test",
      "type": "process",
      "command": "wsl",
      "args": ["--cd", "${workspaceFolder}", "-e", "bash", "-l", "tools/scripts/test.sh"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "host: coverage",
      "type": "process",
      "command": "wsl",
      "args": ["--cd", "${workspaceFolder}", "-e", "bash", "-l", "tools/scripts/coverage.sh"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "host: cppcheck",
      "type": "process",
      "command": "wsl",
      "args": ["--cd", "${workspaceFolder}", "-e", "bash", "-l", "tools/scripts/cppcheck.sh"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "target-check: build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/scripts/build_target_check.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "all checks",
      "dependsOrder": "sequence",
      "dependsOn": ["host: test", "host: coverage", "host: cppcheck", "target-check: build"],
      "problemMatcher": []
    }
  ]
}
